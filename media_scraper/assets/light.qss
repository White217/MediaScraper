/* MediaScraper 浅色主题：白底卡片、青色强调 */

QWidget {
    background-color: #F4F7F8;
    color: #1E293B;
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: #F4F7F8;
}

QLabel {
    background: transparent;
    color: #1E293B;
}

QWidget#pageRoot,
QWidget#sheetHost,
QStackedWidget {
    background-color: #F4F7F8;
}

QFrame#sideNav {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #E6EEF0;
}

QFrame#rightRail {
    background-color: #F4F7F8;
    border: none;
}

QLabel#brandMark {
    color: #0F766E;
    font-size: 13pt;
    font-weight: 700;
    padding: 2px 8px 8px 8px;
}

QLabel#pageTitle {
    color: #0F172A;
    font-size: 18pt;
    font-weight: 700;
}

QLabel#cardTitle {
    color: #0F172A;
    font-size: 11pt;
    font-weight: 700;
}

QLabel#fieldLabel,
QLabel#sourceCount,
QLabel#overallStatus,
QLabel#hintNote {
    color: #64748B;
    font-size: 9pt;
}

QLabel#kpiLabel {
    color: #64748B;
    font-size: 9pt;
}

QLabel#kpiValue {
    color: #0F766E;
    font-size: 22pt;
    font-weight: 700;
}

QFrame#card,
QFrame#kpiCard {
    background-color: #FFFFFF;
    border: 1px solid #E6EEF0;
    border-radius: 12px;
}

QPushButton#navBtn {
    background: transparent;
    color: #475569;
    border: none;
    border-radius: 8px;
    padding: 9px 12px;
    text-align: left;
    font-weight: 600;
}
QPushButton#navBtn:hover {
    background-color: #F0FDFA;
    color: #0F766E;
}
QPushButton#navBtn:checked {
    background-color: #CCFBF1;
    color: #0F766E;
}

QMenuBar {
    background-color: #FFFFFF;
    color: #1E293B;
    border-bottom: 1px solid #E6EEF0;
    padding: 2px 6px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #CCFBF1;
}
QMenu {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #E6EEF0;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #CCFBF1;
    color: #0F766E;
}

QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #E6EEF0;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #0F766E;
    background-color: #FFFFFF;
}

QPushButton {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #D7E2E4;
    border-radius: 8px;
    padding: 7px 14px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #F0FDFA;
    border-color: #14B8A6;
}
QPushButton:pressed {
    background-color: #CCFBF1;
}
QPushButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
    border-color: #E2E8F0;
}

QPushButton#primaryBtn {
    background-color: #14B8A6;
    color: #FFFFFF;
    border: none;
    font-weight: 700;
    padding: 7px 18px;
}
QPushButton#primaryBtn:hover {
    background-color: #0D9488;
}
QPushButton#primaryBtn:pressed {
    background-color: #0F766E;
}
QPushButton#primaryBtn:disabled {
    background-color: #99F6E4;
    color: #F0FDFA;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit, QListWidget {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #E6EEF0;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #14B8A6;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus, QListWidget:focus {
    border: 1px solid #14B8A6;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #F8FAFC;
    color: #94A3B8;
}

QListWidget#taskList {
    border: none;
    background: transparent;
    padding: 0;
}
QListWidget#taskList::item {
    padding: 6px 12px;
    margin: 2px 6px 2px 0;
    border-radius: 6px;
}
QListWidget#taskList::item:selected {
    background-color: #CCFBF1;
    color: #0F766E;
}
QListWidget#taskList::item:hover {
    background-color: #F0FDFA;
}

QTextEdit#logView {
    background-color: #F8FAFC;
    color: #334155;
    border: none;
    border-radius: 8px;
    font-family: Consolas, "Cascadia Mono", monospace;
    font-size: 9pt;
}

QComboBox#themeCombo {
    min-width: 88px;
    padding: 4px 10px;
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1E293B;
    border: 1px solid #E6EEF0;
    selection-background-color: #CCFBF1;
    selection-color: #0F766E;
    outline: none;
}

QCheckBox { background: transparent; spacing: 8px; color: #1E293B; }
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    background-color: #FFFFFF;
}
QCheckBox::indicator:hover { border-color: #14B8A6; }
QCheckBox::indicator:checked {
    background-color: #14B8A6;
    border-color: #0D9488;
}

QScrollArea#sourceScroll {
    background: transparent;
    border: none;
}
QScrollArea#sourceScroll QWidget,
QWidget#sourceInner {
    background: transparent;
}

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FFFFFF;
    border: none;
    gridline-color: transparent;
    selection-background-color: #F0FDFA;
    selection-color: #1E293B;
    outline: none;
}
QTableWidget::item {
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid #F1F5F9;
}
QTableWidget::item:hover { background-color: #F0FDFA; }
QTableWidget::item:selected { background-color: #CCFBF1; color: #1E293B; }
QHeaderView::section {
    background-color: #FFFFFF;
    color: #64748B;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #E6EEF0;
    font-weight: 600;
}
QTableCornerButton::section { background-color: #FFFFFF; border: none; }

QWidget#statusBadgeHost { background: transparent; }
QLabel#statusBadge {
    border-radius: 9px;
    padding: 3px 12px;
    min-width: 3em;
    font-size: 9pt;
    font-weight: 600;
    background-color: #F1F5F9;
    color: #64748B;
}
QLabel#statusBadge[status="waiting"],
QLabel#statusBadge[status="skipped"] {
    background-color: #F1F5F9;
    color: #64748B;
}
QLabel#statusBadge[status="running"],
QLabel#statusBadge[status="success"] {
    background-color: #CCFBF1;
    color: #0F766E;
}
QLabel#statusBadge[status="failed"] {
    background-color: #FEE2E2;
    color: #DC2626;
}

QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 4px;
    min-height: 16px;
    max-height: 20px;
    text-align: center;
    color: #1E293B;
    font-size: 9pt;
}
QProgressBar::chunk {
    background-color: #14B8A6;
    border-radius: 3px;
}
QProgressBar#overallProgress {
    min-height: 6px;
    max-height: 6px;
    border-radius: 3px;
    background-color: #E2E8F0;
}
QProgressBar#overallProgress::chunk {
    background-color: #14B8A6;
    border-radius: 3px;
}
QProgressBar[status="waiting"],
QProgressBar[status="skipped"] {
    background-color: #F1F5F9;
    color: #64748B;
}
QProgressBar[status="waiting"]::chunk,
QProgressBar[status="skipped"]::chunk {
    background-color: #CBD5E1;
    border-radius: 3px;
}
QProgressBar[status="running"],
QProgressBar[status="success"] {
    background-color: #F0FDFA;
    color: #0F766E;
}
QProgressBar[status="running"]::chunk,
QProgressBar[status="success"]::chunk {
    background-color: #14B8A6;
    border-radius: 3px;
}
QProgressBar[status="failed"] {
    background-color: #FEE2E2;
    color: #7F1D1D;
}
QProgressBar[status="failed"]::chunk {
    background-color: #EF4444;
    border-radius: 3px;
}

QTabWidget::pane {
    border: 1px solid #E6EEF0;
    border-radius: 8px;
    background-color: #FFFFFF;
}
QTabBar::tab {
    background-color: #F1F5F9;
    color: #64748B;
    padding: 7px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #14B8A6;
    color: #FFFFFF;
    font-weight: 700;
}
QTabBar::tab:hover:!selected { background-color: #CCFBF1; color: #0F766E; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 4px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover { background-color: #14B8A6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    border-radius: 4px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover { background-color: #14B8A6; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip {
    background-color: #0F172A;
    color: #F8FAFC;
    border: none;
    padding: 4px 6px;
}
