/* MediaScraper 深色主题：黑底、紫色强调 */

QWidget {
    background-color: #0C0B12;
    color: #F4F2FA;
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: #0C0B12;
}

QLabel {
    background: transparent;
    color: #F4F2FA;
}

QWidget#pageRoot,
QWidget#sheetHost,
QStackedWidget {
    background-color: #0C0B12;
}

QFrame#sideNav {
    background-color: #100E18;
    border: none;
    border-right: 1px solid #2A2540;
}

QFrame#rightRail {
    background-color: #0C0B12;
    border: none;
}

QLabel#brandMark {
    color: #C4B5FD;
    font-size: 13pt;
    font-weight: 700;
    padding: 2px 8px 8px 8px;
}

QLabel#pageTitle {
    color: #F8F7FF;
    font-size: 18pt;
    font-weight: 700;
}

QLabel#cardTitle {
    color: #F8F7FF;
    font-size: 11pt;
    font-weight: 700;
}

QLabel#fieldLabel,
QLabel#sourceCount,
QLabel#overallStatus,
QLabel#hintNote {
    color: #A39BB8;
    font-size: 9pt;
}

QLabel#kpiLabel {
    color: #A39BB8;
    font-size: 9pt;
}

QLabel#kpiValue {
    color: #C4B5FD;
    font-size: 22pt;
    font-weight: 700;
}

QFrame#card,
QFrame#kpiCard {
    background-color: #1A1730;
    border: 1px solid #2E2948;
    border-radius: 12px;
}

QPushButton#navBtn {
    background: transparent;
    color: #C4BDD6;
    border: none;
    border-radius: 8px;
    padding: 9px 12px;
    text-align: left;
    font-weight: 600;
}
QPushButton#navBtn:hover {
    background-color: #241F3D;
    color: #EDE9FE;
}
QPushButton#navBtn:checked {
    background-color: #8B5CF6;
    color: #FFFFFF;
}

QMenuBar {
    background-color: #100E18;
    color: #F4F2FA;
    border-bottom: 1px solid #2A2540;
    padding: 2px 6px;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #2A2150;
}
QMenu {
    background-color: #1A1730;
    color: #F4F2FA;
    border: 1px solid #2E2948;
    padding: 4px;
}
QMenu::item {
    padding: 6px 18px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #8B5CF6;
    color: #FFFFFF;
}

QGroupBox {
    background-color: #1A1730;
    border: 1px solid #2E2948;
    border-radius: 8px;
    margin-top: 14px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #C4B5FD;
    background-color: #1A1730;
}

QPushButton {
    background-color: #241F3D;
    color: #F4F2FA;
    border: 1px solid #3B3458;
    border-radius: 8px;
    padding: 7px 14px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #2E2848;
    border-color: #8B5CF6;
}
QPushButton:pressed {
    background-color: #3B2F66;
}
QPushButton:disabled {
    background-color: #161222;
    color: #6B647C;
    border-color: #2A2540;
}

QPushButton#primaryBtn {
    background-color: #8B5CF6;
    color: #FFFFFF;
    border: none;
    font-weight: 700;
    padding: 7px 18px;
}
QPushButton#primaryBtn:hover {
    background-color: #7C3AED;
}
QPushButton#primaryBtn:pressed {
    background-color: #6D28D9;
}
QPushButton#primaryBtn:disabled {
    background-color: #4C1D95;
    color: #DDD6FE;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit, QListWidget {
    background-color: #120F1E;
    color: #F4F2FA;
    border: 1px solid #3B3458;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #8B5CF6;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus, QListWidget:focus {
    border: 1px solid #8B5CF6;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #161222;
    color: #6B647C;
}

QListWidget#taskList {
    border: none;
    background: transparent;
    padding: 0;
}
QListWidget#taskList::item {
    padding: 6px 12px;
    margin: 2px 6px 2px 0;
    border-radius: 6px;
}
QListWidget#taskList::item:selected {
    background-color: #3B2F66;
    color: #F5F3FF;
}
QListWidget#taskList::item:hover {
    background-color: #241F3D;
}

QTextEdit#logView {
    background-color: #120F1E;
    color: #E7E2F3;
    border: none;
    border-radius: 8px;
    font-family: Consolas, "Cascadia Mono", monospace;
    font-size: 9pt;
}

QComboBox#themeCombo {
    min-width: 88px;
    padding: 4px 10px;
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #1A1730;
    color: #F4F2FA;
    border: 1px solid #3B3458;
    selection-background-color: #8B5CF6;
    selection-color: #FFFFFF;
    outline: none;
}

QCheckBox { background: transparent; spacing: 8px; color: #F4F2FA; }
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #4C4568;
    border-radius: 4px;
    background-color: #120F1E;
}
QCheckBox::indicator:hover { border-color: #A78BFA; }
QCheckBox::indicator:checked {
    background-color: #8B5CF6;
    border-color: #7C3AED;
}

QScrollArea#sourceScroll {
    background: transparent;
    border: none;
}
QScrollArea#sourceScroll QWidget,
QWidget#sourceInner {
    background: transparent;
}

QTableWidget {
    background-color: #1A1730;
    alternate-background-color: #1A1730;
    border: none;
    gridline-color: transparent;
    selection-background-color: #2A2150;
    selection-color: #F8F7FF;
    outline: none;
}
QTableWidget::item {
    padding: 4px 8px;
    border: none;
    border-bottom: 1px solid #2A2540;
}
QTableWidget::item:hover { background-color: #241F3D; }
QTableWidget::item:selected { background-color: #3B2F66; color: #F8F7FF; }
QHeaderView::section {
    background-color: #1A1730;
    color: #A39BB8;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #2E2948;
    font-weight: 600;
}
QTableCornerButton::section { background-color: #1A1730; border: none; }

QWidget#statusBadgeHost { background: transparent; }
QLabel#statusBadge {
    border-radius: 9px;
    padding: 3px 12px;
    min-width: 3em;
    font-size: 9pt;
    font-weight: 600;
    background-color: #241F3D;
    color: #A39BB8;
}
QLabel#statusBadge[status="waiting"],
QLabel#statusBadge[status="skipped"] {
    background-color: #241F3D;
    color: #A39BB8;
}
QLabel#statusBadge[status="running"],
QLabel#statusBadge[status="success"] {
    background-color: #3B2F66;
    color: #DDD6FE;
}
QLabel#statusBadge[status="failed"] {
    background-color: #3F1D2E;
    color: #FCA5A5;
}

QProgressBar {
    background-color: #2A2540;
    border: none;
    border-radius: 4px;
    min-height: 16px;
    max-height: 20px;
    text-align: center;
    color: #F4F2FA;
    font-size: 9pt;
}
QProgressBar::chunk {
    background-color: #8B5CF6;
    border-radius: 3px;
}
QProgressBar#overallProgress {
    min-height: 6px;
    max-height: 6px;
    border-radius: 3px;
    background-color: #2A2540;
}
QProgressBar#overallProgress::chunk {
    background-color: #8B5CF6;
    border-radius: 3px;
}
QProgressBar[status="waiting"],
QProgressBar[status="skipped"] {
    background-color: #241F3D;
    color: #A39BB8;
}
QProgressBar[status="waiting"]::chunk,
QProgressBar[status="skipped"]::chunk {
    background-color: #4C4568;
    border-radius: 3px;
}
QProgressBar[status="running"],
QProgressBar[status="success"] {
    background-color: #2A2150;
    color: #EDE9FE;
}
QProgressBar[status="running"]::chunk,
QProgressBar[status="success"]::chunk {
    background-color: #8B5CF6;
    border-radius: 3px;
}
QProgressBar[status="failed"] {
    background-color: #3F1D2E;
    color: #FECACA;
}
QProgressBar[status="failed"]::chunk {
    background-color: #F87171;
    border-radius: 3px;
}

QTabWidget::pane {
    border: 1px solid #2E2948;
    border-radius: 8px;
    background-color: #1A1730;
}
QTabBar::tab {
    background-color: #241F3D;
    color: #A39BB8;
    padding: 7px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #8B5CF6;
    color: #FFFFFF;
    font-weight: 700;
}
QTabBar::tab:hover:!selected { background-color: #3B2F66; color: #EDE9FE; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar::handle:vertical {
    background-color: #3B3458;
    border-radius: 4px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover { background-color: #8B5CF6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal {
    background-color: #3B3458;
    border-radius: 4px;
    min-width: 28px;
}
QScrollBar::handle:horizontal:hover { background-color: #8B5CF6; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip {
    background-color: #1A1730;
    color: #F8F7FF;
    border: 1px solid #3B3458;
    padding: 4px 6px;
}
