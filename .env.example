# 复制为 .env 后填写。.env 不要提交。
# 同目录已有 config.yaml 时，这里的非空变量会在启动时覆盖对应字段。

TMDB_API_KEY=
JAVINFO_API_KEY=
DMM_API_ID=
DMM_AFFILIATE_ID=

# 1 / true / yes / on 为启用，0 / false / no / off 为关闭
MEDIASCRAPER_PROXY_ENABLED=
MEDIASCRAPER_PROXY_TYPE=
MEDIASCRAPER_PROXY_HOST=
MEDIASCRAPER_PROXY_PORT=
MEDIASCRAPER_PROXY_USERNAME=
MEDIASCRAPER_PROXY_PASSWORD=

# 设置后会把 rename.output_mode 切到 custom_dir
MEDIASCRAPER_OUTPUT_DIR=
